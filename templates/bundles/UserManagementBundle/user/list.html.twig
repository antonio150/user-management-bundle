{% extends 'base.html.twig' %}

{% block body %}
<h2>Liste des utilisateurs</h2>
<table>
    <tr>
        <th>ID</th>
        <th>Email</th>
        <th>Rôles</th>
        <th>Actions</th>
    </tr>
    {% for user in users %}
    <tr>
        <td>{{ user.id }}</td>
        <td>{{ user.email }}</td>
        <td>{{ user.roles|join(', ') }}</td>
        <td><a href="{{ path('user_edit', {'id': user.id}) }}">Modifier</a></td>
    </tr>
    {% endfor %}
</table>
{% endblock %}
